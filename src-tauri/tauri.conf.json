{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bouge",
  "version": "0.1.0",
  "identifier": "app.bouge.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Bouge",
        "url": "index.html",
        "width": 720,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500
      },
      {
        "label": "pill",
        "title": "Bouge pill",
        "url": "pill.html",
        "width": 230,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "HealthAndFitness",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
