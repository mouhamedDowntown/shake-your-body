{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bouge",
  "version": "0.1.0",
  "identifier": "app.bouge.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bouge",
        "url": "index.html",
        "width": 720,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthAndFitness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
